# Origen de los datos:
#   mock → backend simulado en el navegador, con datos de ejemplo (por defecto).
#   http → backend real (los módulos que aún no existan responden 501; ver INTEGRACION.md).
VITE_API_MODE=mock

# URL base de la API real. Por defecto "/api" (usa el proxy de Vite en desarrollo).
# En producción, apuntar al backend: https://api.ejemplo.com/api
VITE_API_URL=/api

# Destino del proxy de desarrollo (solo para `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:3000
