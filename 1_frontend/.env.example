# Origen de los datos:
#   mock → backend simulado en el navegador, con datos de ejemplo (por defecto).
#   http → backend real. Los módulos que el backend aún no tiene se muestran como "pronto" (ver INTEGRACION.md).
VITE_API_MODE=mock

# URL base de la API real. Por defecto "/api" (usa el proxy de Vite en desarrollo).
# En producción (Netlify): VITE_API_MODE=http y VITE_API_URL=https://<tu-backend>.vercel.app/api
VITE_API_URL=/api

# Destino del proxy de desarrollo (solo para `npm run dev`).
VITE_API_PROXY_TARGET=http://localhost:3000
