NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Connect > Direct connection (IPv6) o Session pooler (IPv4).
# Usá la contraseña PostgreSQL, con caracteres especiales codificados en la URL.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST:5432/postgres
DATABASE_SSL=true
DATABASE_POOL_MAX=5
# Certificado público descargado desde Supabase > Database Settings > SSL Configuration.
# La ruta es relativa a 2_backend al ejecutar npm start desde esa carpeta.
DATABASE_CA_PATH=./certs/prod-ca-2021.crt

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR
# Solo backend: API Keys > Secret key (o service_role heredada). Nunca en Vite.
SUPABASE_SECRET_KEY=REEMPLAZAR
